<?xml version="1.0"?>
<package format="3">
  <name>idmp_ros</name>
  <version>2.0.0</version>
  <description>ROS2 wrapper for IDMP (Incremental Dynamic Mapping Pipeline)</description>

  <maintainer email="lan@example.com">Lan Wu</maintainer>
  <license>BSD-3-Clause</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Interfaces now live in a separate package -->
  <depend>idmp_interfaces</depend>

  <!-- Core runtime deps -->
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>message_filters</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>image_transport</depend>
  <depend>image_geometry</depend>
  <depend>pcl_conversions</depend>

  <!-- If nclude headers from Eigen/OpenCV/Boost/PCL via find_package,
       optionally list them here as build/run deps too (not mandatory for ROS index):
       <depend>eigen</depend>
       <depend>opencv</depend>
       <depend>pcl_msgs</depend>
       <depend>boost</depend>
  -->

  <!-- depth_image_proc optional -->
  <!-- <exec_depend>depth_image_proc</exec_depend> -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
